// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================

enum Role {
  GUEST
  CUSTOMER
  OPERATOR
  ADMIN
}

enum VehicleCategory {
  BUS 
  TRAIN
}

enum TicketType { 
  NORMAL
  VIP
}

enum OperatorStatus {
  ACTIVE
  INACTIVE
}

enum BusType {
  SLEEPER
  LIMOUSINE
  CHAIR
}

enum ScheduleStatus {
  AVAILABLE
  CANCELLED
  COMPLETED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  MOMO
  VNPAY
  BANK_TRANSFER
}

// ================= MODELS =================

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  fullName  String
  phone     String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]

  @@map("users")
}

model Operator {
  id           String         @id @default(uuid())
  name         String
  description  String?        @db.Text
  logoUrl      String?
  contactPhone String
  status       OperatorStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  trips        Trip[]

  @@map("operators")
}

model Route {
  id                String   @id @default(uuid())
  origin            String
  destination       String
  distance          Float
  estimatedDuration Int      // in minutes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trips             Trip[]

  @@index([origin, destination])
  @@map("routes")
}

model Trip {
  id              String          @id @default(uuid())
  operatorId      String
  routeId         String
  vehicleCategory VehicleCategory @default(BUS) // Xác định đây là tàu hay xe
  busType         BusType         // Có thể đổi tên thành 'vehicleType' cho chuẩn nghĩa hơn, nhưng giữ busType vẫn ổn
  basePrice       Decimal         @db.Decimal(10, 2)
  description     String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  operator        Operator @relation(fields: [operatorId], references: [id])
  route           Route    @relation(fields: [routeId], references: [id])
  schedules       Schedule[]

  @@map("trips")
}

model Schedule {
  id            String         @id @default(uuid())
  tripId        String
  departureTime DateTime
  arrivalTime   DateTime
  status        ScheduleStatus @default(AVAILABLE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  trip          Trip           @relation(fields: [tripId], references: [id])
  seats         Seat[]
  bookings      Booking[]

  @@index([departureTime])
  @@map("schedules")
}

model Seat {
  id          String     @id @default(uuid())
  scheduleId  String
  seatNumber  String     // Xe: "A1", Tàu: "Ghế 12"
  carriage    String?    // Toa tàu (VD: "Toa 1", "Toa Thương Gia"). Với xe khách có thể để null
  floor       Int        @default(1) // Vẫn giữ lại floor cho xe giường nằm 2 tầng
  ticketType  TicketType @default(NORMAL) // Xác định ghế này là VIP hay Thường
  status      SeatStatus @default(AVAILABLE)
  price       Decimal?   @db.Decimal(10, 2)
  lockedUntil DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schedule    Schedule   @relation(fields: [scheduleId], references: [id])
  ticket      Ticket?

  @@map("seats")
}

model Booking {
  id            String        @id @default(uuid())
  userId        String?       // Chuyển thành Optional (?) để Guest có thể mua
  scheduleId    String
  
  // Thêm thông tin liên lạc cho trường hợp là Guest
  guestName     String?
  guestPhone    String?
  guestEmail    String?

  totalAmount   Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod
  bookingCode   String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User?         @relation(fields: [userId], references: [id]) // User cũng phải Optional
  schedule      Schedule      @relation(fields: [scheduleId], references: [id])
  tickets       Ticket[]

  @@map("bookings")
}

model Ticket {
  id             String     @id @default(uuid())
  bookingId      String
  seatId         String     @unique 
  purchasedPrice Decimal    @db.Decimal(10, 2) // Gợi ý từ trước: Lưu cứng giá lúc mua
  passengerName  String?
  passengerPhone String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  booking        Booking  @relation(fields: [bookingId], references: [id])
  seat           Seat     @relation(fields: [seatId], references: [id])

  @@map("tickets")
}